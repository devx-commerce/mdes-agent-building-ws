{
 "id": "res-a-en-rejected",
 "agent": "RES-A",
 "lang": "en",
 "why": "Failure path (Vishal ra1-plan-rejected): she rejects the plan -> a 'plan rejected' row in the change record, nothing researched or saved.",
 "run_with": "python3 tests/fixtures/researcher.py run tests/cases/res-a-en-rejected.json",
 "start": "Run the scheduled check now.",
 "cards": [
  {
   "when": {
    "node": "plan_approval"
   },
   "do": "reject",
