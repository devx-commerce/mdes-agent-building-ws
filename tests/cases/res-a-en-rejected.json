  "status": "end",
  "cards_seen": [
   "plan_approval"
  ],
  "cards_not_seen": [
   "deep_research_run",
   "follow_up"
  ],
  "no_files": [
   "^ตารางเปรียบเทียบหลักฐาน",
   "^บทสรุปพร้อมแหล่งอ้างอิง",
   "^รายงานการค้นคว้า"
  ],
  "thai_final": false
 }
}
