{
 "id": "res-b-en-rejected",
 "agent": "RES-B",
 "lang": "en",
 "why": "Failure path: the researcher rejects the data-issues card -> the run stops; nothing analysed, written or sent.",
 "run_with": "python3 tests/fixtures/researcher.py run tests/cases/res-b-en-rejected.json",
 "start": "Run the scheduled check now.",
 "cards": [
  {
   "when": {
    "node": "handling_rules"
   },
   "do": "reject",
   "feedback": "Not yet, wait for the next batch"
  }
 ],
 "default_card": "approve",
 "max_cards": 4,
 "max_minutes": 25,
 "expect": {
  "status": "end",
  "cards_seen": [
   "handling_rules"
  ],
  "cards_not_seen": [
   "create_chart",
   "create_presentation",
   "send_email",
   "append_rows",
   "copy_file"
  ],
  "no_files": [
   "^บทที่ 4",
   "^สไลด์ผลการวิจัย",
   "^ข้อมูลกราฟ"
  ],
  "thai_final": false
 }
}
